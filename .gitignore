# MediaPipe task bundles (~13MB) - fetch with: python ml/download_models.py
ml/models/*.task

# Source video and archives stay out - INCLUDE is 56GB, and the 57MB .glb
# already in this repo's history is the cautionary tale.
data/*.zip
*.mp4

# Reference clips shipped with the page are the exception: nine INCLUDE clips
# at ~30KB each, rebuilt by ml/build_reference_clips.py.
!public/signs/*.mp4

# Extracted landmark features and the trained model ARE committed (~9MB).
# They are derived from INCLUDE (CC-BY-4.0) and are what makes train.py
# reproducible without a 2.7GB download.
